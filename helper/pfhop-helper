#!/usr/bin/python3 -I
"""pfhop-helper - the ONLY program pfhop is allowed to run as root (via sudo).

It accepts a fixed set of sub-commands with strictly validated arguments, so
the web application never gets a general-purpose root shell.

Install as root-owned, mode 0755:  /usr/libexec/pfhop/pfhop-helper
sudoers:  pfhop ALL=(root) NOPASSWD: /usr/libexec/pfhop/pfhop-helper *

Sub-commands:
  backup-postfix                     write a .tar.gz of the Postfix config to stdout
  service start|stop|restart|reload  control postfix.service
  queue-delete QUEUE_ID...           delete messages from the queue
  queue-hold QUEUE_ID...             put messages on hold
  queue-release QUEUE_ID...          release messages from hold
  apply                              apply a configuration change read as JSON from stdin
                                     (validated, checked with "postfix check", rolled back on error)

For testing, root may set PFHOP_TEST_CONFIG_DIR=/path/to/copy to make "apply" work on a
copy of the configuration (no reload). sudo's env_reset keeps the web app from using it.
"""

import io
import json
import os
import re
import socket
import subprocess
import sys
import tarfile
import time

POSTCONF = "/usr/sbin/postconf"
POSTSUPER = "/usr/sbin/postsuper"
SYSTEMCTL = "/usr/bin/systemctl"
QUEUE_ID_RE = re.compile(r"^[0-9A-Za-z]{6,20}$")
MAX_IDS = 5000
POSTFIX = "/usr/sbin/postfix"
POSTMAP = "/usr/sbin/postmap"

# Parameters the web UI may change (keep in sync with pfhop/postfix/catalog.py + relays.py).
EDITABLE_PARAMS = {
    # General
    "myhostname", "mydomain", "myorigin", "inet_interfaces", "inet_protocols", "smtpd_banner",
    # Message & MIME
    "message_size_limit", "header_size_limit", "smtpd_recipient_limit", "smtputf8_enable",
    "disable_mime_input_processing", "disable_mime_output_conversion", "strict_rfc821_envelopes",
    "always_add_missing_headers", "header_checks", "mime_header_checks", "body_checks",
    # Security & TLS
    "smtpd_tls_security_level", "smtpd_tls_cert_file", "smtpd_tls_key_file", "smtpd_tls_protocols",
    "smtp_tls_security_level", "smtp_tls_CAfile", "smtp_tls_protocols", "smtpd_helo_required",
    "disable_vrfy_command", "smtpd_client_connection_count_limit", "smtpd_client_connection_rate_limit",
    "smtpd_client_message_rate_limit", "smtpd_client_recipient_rate_limit", "anvil_rate_time_unit",
    # Queue & delivery
    "maximal_queue_lifetime", "bounce_queue_lifetime", "delay_warning_time", "minimal_backoff_time",
    "maximal_backoff_time", "queue_run_delay", "default_destination_concurrency_limit",
    "smtp_destination_concurrency_limit", "smtp_destination_rate_delay", "smtp_connect_timeout",
    "queue_minfree",
    # Routing (generated by pfhop from the Relay servers / Allowed clients tabs)
    "relayhost", "default_transport", "sender_dependent_default_transport_maps",
    "smtpd_client_restrictions", "mynetworks",
}
TRANSPORT_PARAM_RE = re.compile(r"^pfr_[a-z0-9_]{1,24}_destination_(concurrency_limit|rate_delay)$")
TRANSPORT_NAME_RE = re.compile(r"^pfr_[a-z0-9_]{1,24}$")
TRANSPORT_OPTIONS = {
    "syslog_name", "smtp_tls_security_level", "smtp_tls_wrappermode", "smtp_sasl_auth_enable",
    "smtp_sasl_password_maps", "smtp_sasl_security_options", "smtp_sasl_tls_security_options",
}
OPTION_VALUE_RE = re.compile(r"^[A-Za-z0-9_./:@=-]{0,200}$")
MANAGED_FILES = {"sender_relay": (0o644, True), "client_relay.cidr": (0o644, False),
                 "sasl_passwd": (0o600, True)}   # name: (mode, needs postmap)
MANAGED_BEGIN = "# BEGIN pfhop managed transports - do not edit by hand"
MANAGED_END = "# END pfhop managed transports"
POSTFIX_CONFIG_DIR = "/etc/postfix"
MAX_FILE_SIZE = 50 * 1024 * 1024  # skip anything absurdly large


def run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8",
                          errors="replace", timeout=30, check=False).stdout


def _add_bytes(tar, name, data, mode=0o600):
    info = tarfile.TarInfo(name)
    info.size = len(data)
    info.mtime = int(time.time())
    info.mode = mode
    tar.addfile(info, io.BytesIO(data))


def backup_postfix():
    config_dir = run([POSTCONF, "-h", "config_directory"]).strip() or POSTFIX_CONFIG_DIR
    buf = io.BytesIO()
    files = []
    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
        for root, dirs, names in os.walk(config_dir):
            dirs.sort()
            for name in sorted(names):
                path = os.path.join(root, name)
                if os.path.islink(path) or not os.path.isfile(path):
                    continue
                if os.path.getsize(path) > MAX_FILE_SIZE:
                    continue
                arcname = "postfix/" + os.path.relpath(path, config_dir)
                tar.add(path, arcname=arcname, recursive=False)
                files.append(arcname)
        _add_bytes(tar, "info/postconf-n.txt", run([POSTCONF, "-n"]).encode())
        _add_bytes(tar, "info/postconf-M.txt", run([POSTCONF, "-M"]).encode())
        _add_bytes(tar, "info/postconf-P.txt", run([POSTCONF, "-P"]).encode())
        manifest = {
            "type": "pfhop-postfix-backup",
            "format": 1,
            "created_at": int(time.time()),
            "hostname": socket.gethostname(),
            "mail_version": run([POSTCONF, "-h", "mail_version"]).strip(),
            "config_directory": config_dir,
            "files": files,
        }
        _add_bytes(tar, "manifest.json", json.dumps(manifest, indent=2).encode())
    sys.stdout.buffer.write(buf.getvalue())
    return 0


def service(action):
    if action not in ("start", "stop", "restart", "reload"):
        print("pfhop-helper: invalid service action", file=sys.stderr)
        return 2
    proc = subprocess.run([SYSTEMCTL, action, "postfix.service"], capture_output=True,
                          text=True, timeout=120, check=False)
    sys.stderr.write(proc.stderr)
    return proc.returncode


def _postsuper(flag, ids):
    if not ids or len(ids) > MAX_IDS or not all(QUEUE_ID_RE.match(i) for i in ids):
        print("pfhop-helper: invalid queue id(s)", file=sys.stderr)
        return 2
    # "-" makes postsuper read the IDs from stdin (one per line).
    proc = subprocess.run([POSTSUPER, flag, "-"], input="\n".join(ids) + "\n",
                          capture_output=True, text=True, timeout=120, check=False)
    sys.stdout.write(proc.stderr)  # postsuper reports "Deleted: N messages" on stderr
    return proc.returncode


class ApplyError(Exception):
    pass


def _validate_value(name, value):
    if not isinstance(value, str) or len(value) > 4000 or re.search(r"[\x00-\x1f\x7f]", value):
        raise ApplyError(f"invalid value for {name}")


def _render_master_block(transports, confdir):
    lines = [MANAGED_BEGIN]
    for t in transports:
        name = t.get("name", "")
        if not TRANSPORT_NAME_RE.match(name):
            raise ApplyError(f"invalid transport name {name!r}")
        lines.append(f"{name} unix - - n - - smtp")
        for key, val in t.get("options", {}).items():
            val = str(val).replace("@CONF@", confdir)
            if key not in TRANSPORT_OPTIONS or not OPTION_VALUE_RE.match(val):
                raise ApplyError(f"invalid transport option {key}={val!r}")
            lines.append(f"  -o {key}={val}")
    lines.append(MANAGED_END)
    return "\n".join(lines) + "\n"


def _replace_block(text, block):
    start, end = text.find(MANAGED_BEGIN), text.find(MANAGED_END)
    if start != -1 and end != -1:
        end = text.find("\n", end)
        end = len(text) if end == -1 else end + 1
        return text[:start] + block + text[end:]
    if not text.endswith("\n"):
        text += "\n"
    return text + "\n" + block


def _snapshot(paths):
    snap = {}
    for path in paths:
        try:
            with open(path, "rb") as fh:
                snap[path] = (fh.read(), os.stat(path).st_mode & 0o777)
        except FileNotFoundError:
            snap[path] = None
    return snap


def _restore(snap):
    for path, saved in snap.items():
        if saved is None:
            try:
                os.unlink(path)
            except FileNotFoundError:
                pass
        else:
            data, mode = saved
            _write_atomic(path, data, mode)


def _write_atomic(path, data, mode):
    tmp = f"{path}.pfhop-tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "wb") as fh:
        fh.write(data)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def _cmd(args, timeout=60):
    proc = subprocess.run(args, capture_output=True, text=True, encoding="utf-8",
                          errors="replace", timeout=timeout, check=False)
    return proc.returncode, (proc.stdout + proc.stderr).strip()


def apply():
    test_dir = os.environ.get("PFHOP_TEST_CONFIG_DIR", "")
    confdir = test_dir or run([POSTCONF, "-h", "config_directory"]).strip() or POSTFIX_CONFIG_DIR
    confdir = os.path.realpath(confdir)
    cflag = ["-c", confdir]
    try:
        req = json.loads(sys.stdin.read(2 * 1024 * 1024))
        sets = req.get("set", {})
        unset = req.get("unset", [])
        files = req.get("files", {})
        block = req.get("master_block")
        reload = bool(req.get("reload", True)) and not test_dir
        for name, value in sets.items():
            if name not in EDITABLE_PARAMS and not TRANSPORT_PARAM_RE.match(name):
                raise ApplyError(f"parameter {name} may not be changed")
            _validate_value(name, value)
        for name in unset:
            if name not in EDITABLE_PARAMS and not TRANSPORT_PARAM_RE.match(name):
                raise ApplyError(f"parameter {name} may not be removed")
        for fname, content in files.items():
            if fname not in MANAGED_FILES or not isinstance(content, str) or "\x00" in content \
                    or len(content) > 1024 * 1024:
                raise ApplyError(f"invalid managed file {fname!r}")
        block_text = _render_master_block(block, confdir) if block is not None else None
    except (ValueError, ApplyError, AttributeError, TypeError) as exc:
        print(json.dumps({"ok": False, "error": f"invalid request: {exc}"}))
        return 3

    map_dir = os.path.join(confdir, "pfhop")
    targets = [os.path.join(confdir, "main.cf"), os.path.join(confdir, "master.cf")]
    for fname in MANAGED_FILES:
        targets += [os.path.join(map_dir, fname), os.path.join(map_dir, fname + ".lmdb")]
    snap = _snapshot(targets)
    log = []
    try:
        os.makedirs(map_dir, mode=0o755, exist_ok=True)
        os.chmod(map_dir, 0o755)
        for fname, content in files.items():
            mode, needs_map = MANAGED_FILES[fname]
            path = os.path.join(map_dir, fname)
            _write_atomic(path, content.replace("@CONF@", confdir).encode(), mode)
            if needs_map:
                rc, out = _cmd([POSTMAP, *cflag, f"lmdb:{path}"])
                if rc != 0:
                    raise ApplyError(f"postmap {fname}: {out}")
                if os.path.exists(path + ".lmdb"):
                    os.chmod(path + ".lmdb", mode)
            log.append(f"wrote pfhop/{fname}")
        if block_text is not None:
            master = os.path.join(confdir, "master.cf")
            with open(master, encoding="utf-8") as fh:
                text = fh.read()
            new = _replace_block(text, block_text)
            if new != text:
                _write_atomic(master, new.encode(), os.stat(master).st_mode & 0o777)
                log.append("updated master.cf relay transports")
        if sets:
            args = [f"{k}={v.replace('@CONF@', confdir)}" for k, v in sets.items()]
            rc, out = _cmd([POSTCONF, *cflag, "-e", *args])
            if rc != 0:
                raise ApplyError(f"postconf -e: {out}")
            log.append(f"set {len(sets)} parameter(s)")
        # Read names straight from main.cf: "postconf -n" hides parameters it considers unused
        # (e.g. pfr_x_destination_* after the pfr_x transport was removed from master.cf).
        with open(os.path.join(confdir, "main.cf"), encoding="utf-8", errors="replace") as fh:
            present = {m.group(1) for m in re.finditer(r"^([A-Za-z0-9_]+)\s*=", fh.read(), re.M)}
        to_unset = [n for n in unset if n in present]
        if block is not None:
            # Per-relay parameters of relays that no longer exist.
            to_unset += [n for n in present if TRANSPORT_PARAM_RE.match(n) and n not in sets
                         and n not in to_unset]
        if to_unset:
            rc, out = _cmd([POSTCONF, *cflag, "-X", *to_unset])
            if rc != 0:
                raise ApplyError(f"postconf -X: {out}")
            log.append(f"removed {len(to_unset)} parameter(s)")
        rc, out = _cmd([POSTFIX, *cflag, "check"])
        if rc != 0 or "fatal" in out.lower() or "error" in out.lower():
            raise ApplyError(f"postfix check failed: {out or rc}")
        if out:
            log.append(f"postfix check: {out}")
        if reload:
            rc, out = _cmd([SYSTEMCTL, "is-active", "--quiet", "postfix.service"])
            if rc == 0:
                rc, out = _cmd([POSTFIX, "reload"])
                if rc != 0:
                    raise ApplyError(f"postfix reload failed: {out}")
                log.append("postfix reloaded")
            else:
                log.append("postfix is not running - not reloaded")
    except (ApplyError, OSError, subprocess.TimeoutExpired) as exc:
        _restore(snap)
        if reload:
            _cmd([POSTFIX, "reload"])
        print(json.dumps({"ok": False, "error": str(exc), "log": log, "rolled_back": True}))
        return 1
    print(json.dumps({"ok": True, "log": log}))
    return 0


COMMANDS = {
    # name: (function, number of args; -1 = one or more)
    "backup-postfix": (backup_postfix, 0),
    "service": (service, 1),
    "queue-delete": (lambda *ids: _postsuper("-d", list(ids)), -1),
    "queue-hold": (lambda *ids: _postsuper("-h", list(ids)), -1),
    "queue-release": (lambda *ids: _postsuper("-H", list(ids)), -1),
    "apply": (apply, 0),
}


def main(argv):
    if os.geteuid() != 0:
        print("pfhop-helper: must run as root", file=sys.stderr)
        return 2
    if len(argv) < 2 or argv[1] not in COMMANDS:
        print("usage: pfhop-helper {" + ",".join(sorted(COMMANDS)) + "}", file=sys.stderr)
        return 2
    func, nargs = COMMANDS[argv[1]]
    args = argv[2:]
    if (nargs == -1 and not args) or (nargs >= 0 and len(args) != nargs):
        print(f"pfhop-helper: wrong number of arguments for {argv[1]}", file=sys.stderr)
        return 2
    return func(*args)


if __name__ == "__main__":
    os.umask(0o077)
    os.environ["PATH"] = "/usr/sbin:/usr/bin:/sbin:/bin"
    sys.exit(main(sys.argv))
