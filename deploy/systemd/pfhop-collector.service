[Unit]
Description=pfhop - Postfix mail log collector (systemd journal follower)
After=systemd-journald.service postfix.service

[Service]
Type=simple
User=pfhop
Group=pfhop
# Read access to the system journal, nothing more.
SupplementaryGroups=systemd-journal
Environment=PFHOP_CONFIG=/etc/pfhop/pfhop.conf
Environment=LANG=C.UTF-8
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/venv/bin/python -m pfhop collect
Restart=always
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pfhop
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
